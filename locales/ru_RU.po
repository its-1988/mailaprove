# ─── Validation actions ─────────────────────────────────────────────────────

msgid "Confirmar aprovação"
msgstr "Подтвердить утверждение"

msgid "Revise o chamado antes de aprovar esta validação por e-mail."
msgstr "Проверьте заявку перед утверждением согласования по почте."

msgid "Revise a validação solicitada para este chamado."
msgstr "Просмотрите запрошенное согласование заявки."

msgid "Aprovar"
msgstr "Утвердить"

msgid "Recusar"
msgstr "Отклонить"

msgid "Aprovar validação"
msgstr "Утвердить согласование"

msgid "Após confirmar, a validação será aprovada no GLPI e os links relacionados serão invalidados."
msgstr "После подтверждения согласование будет утверждено в GLPI, связанные ссылки станут недействительными."

msgid "Aprovado por e-mail"
msgstr "Утверждено по почте"

msgid "Validação aprovada"
msgstr "Согласование утверждено"

msgid "A validação do chamado #%d foi aprovada com sucesso."
msgstr "Согласование заявки #%d успешно утверждено."

msgid "Não foi possível aprovar a validação. Acesse o GLPI para verificar o chamado."
msgstr "Не удалось утвердить согласование. Откройте GLPI чтобы проверить заявку."

msgid "Recusar validação"
msgstr "Отклонить согласование"

msgid "Informe o motivo da recusa."
msgstr "Укажите причину отказа."

msgid "Validação recusada"
msgstr "Согласование отклонено"

msgid "A validação do chamado #%d foi recusada."
msgstr "Согласование заявки #%d отклонено."

msgid "Não foi possível recusar a validação. Acesse o GLPI para verificar o chamado."
msgstr "Не удалось отклонить согласование. Откройте GLPI чтобы проверить заявку."

# ─── Solution actions ───────────────────────────────────────────────────────

msgid "Confirmar aceite da solução"
msgstr "Подтвердить принятие решения"

msgid "Revise o chamado antes de aceitar esta solução por e-mail."
msgstr "Проверьте заявку перед принятием решения по почте."

msgid "Aceitar solução"
msgstr "Принять решение"

msgid "Após confirmar, a solução será marcada como aceita no GLPI e os links relacionados serão invalidados."
msgstr "После подтверждения решение будет принято в GLPI, связанные ссылки станут недействительными."

msgid "Uma solução foi registrada. Confirme se ela resolveu sua solicitação."
msgstr "Зарегистрировано решение. Подтвердите, помогло ли оно вам."

msgid "Solução aceita por e-mail"
msgstr "Решение принято по почте"

msgid "Solução aceita"
msgstr "Решение принято"

msgid "A solução do chamado #%d foi aceita com sucesso."
msgstr "Решение по заявке #%d успешно принято."

msgid "Não foi possível aceitar a solução. Acesse o GLPI para verificar o chamado."
msgstr "Не удалось принять решение. Откройте GLPI чтобы проверить заявку."

msgid "Recusar solução"
msgstr "Отклонить решение"

msgid "Informe o motivo da recusa da solução."
msgstr "Укажите причину отказа от решения."

msgid "Solução recusada por e-mail. Motivo: %s"
msgstr "Решение отклонено по почте. Причина: %s"

msgid "Solução recusada"
msgstr "Решение отклонено"

msgid "A solução do chamado #%d foi recusada."
msgstr "Решение по заявке #%d отклонено."

msgid "Não foi possível recusar a solução. Acesse o GLPI para verificar o chamado."
msgstr "Не удалось отклонить решение. Откройте GLPI чтобы проверить заявку."

# ─── Satisfaction survey ────────────────────────────────────────────────────

msgid "Responder pesquisa"
msgstr "Ответить на опрос"

msgid "Como você avalia a resolução desta solicitação?"
msgstr "Как вы оцениваете решение вашей заявки?"

msgid "Sua resposta ajuda a melhorar a qualidade do atendimento."
msgstr "Ваш ответ помогает улучшать качество поддержки."

msgid "Sua opinião ajuda a melhorar a experiência de atendimento."
msgstr "Ваше мнение помогает улучшать сервис поддержки."

msgid "Sua nota"
msgstr "Ваша оценка"

msgid "Excelente"
msgstr "Отлично"

msgid "Muito bom"
msgstr "Очень хорошо"

msgid "Bom"
msgstr "Хорошо"

msgid "Regular"
msgstr "Удовлетворительно"

msgid "Ruim"
msgstr "Плохо"

msgid "Comentário adicional (opcional)"
msgstr "Дополнительный комментарий (необязательно)"

msgid "Compartilhe algum detalhe sobre o atendimento..."
msgstr "Поделитесь подробностями об обслуживании..."

msgid "Enviar pesquisa"
msgstr "Отправить опрос"

msgid "Selecione uma nota entre 1 e 5 estrelas."
msgstr "Выберите оценку от 1 до 5 звёзд."

msgid "Pesquisa enviada"
msgstr "Опрос отправлен"

msgid "Obrigado pelo feedback sobre o chamado #%d."
msgstr "Спасибо за отзыв по заявке #%d."

msgid "Não foi possível enviar a pesquisa. Acesse o GLPI para verificar o chamado."
msgstr "Не удалось отправить опрос. Откройте GLPI чтобы проверить заявку."

msgid "Pesquisa já respondida"
msgstr "Опрос уже отвечен"

msgid "Esta pesquisa de satisfação já foi respondida."
msgstr "На этот опрос удовлетворённости уже отвечали."

msgid "Pesquisa não encontrada"
msgstr "Опрос не найден"

msgid "A pesquisa de satisfação informada neste link não foi encontrada."
msgstr "Опрос удовлетворённости из этой ссылки не найден."

# ─── Errors and statuses ────────────────────────────────────────────────────

msgid "Token ausente"
msgstr "Токен отсутствует"

msgid "Nenhum token de aprovação foi informado. Use o link original recebido por e-mail."
msgstr "Токен согласования не указан. Используйте оригинальную ссылку из письма."

msgid "Nenhum token foi informado. Use o link original recebido por e-mail."
msgstr "Токен не указан. Используйте оригинальную ссылку из письма."

msgid "Ação já processada"
msgstr "Действие уже выполнено"

msgid "Este link já foi utilizado ou outra ação relacionada já foi concluída."
msgstr "Эта ссылка уже использована или связанное действие уже выполнено."

msgid "Link expirado"
msgstr "Срок ссылки истёк"

msgid "Este link expirou. Acesse o GLPI para continuar o atendimento."
msgstr "Срок ссылки истёк. Откройте GLPI чтобы продолжить обработку."

msgid "Ação inválida"
msgstr "Недействительное действие"

msgid "Este link não corresponde à ação solicitada."
msgstr "Эта ссылка не соответствует запрошенному действию."

msgid "Link inválido"
msgstr "Недействительная ссылка"

msgid "Não foi possível validar este link. Use o link original recebido por e-mail."
msgstr "Не удалось проверить ссылку. Используйте оригинальную ссылку из письма."

msgid "Validação não encontrada"
msgstr "Согласование не найдено"

msgid "A solicitação de validação não foi encontrada. Ela pode ter sido removida no GLPI."
msgstr "Запрос на согласование не найден. Возможно, он был удалён в GLPI."

msgid "Link inconsistente"
msgstr "Несогласованная ссылка"

msgid "Este link não corresponde mais à validação do chamado informado."
msgstr "Эта ссылка больше не соответствует согласованию указанной заявки."

msgid "Este link não corresponde mais à solução do chamado informado."
msgstr "Эта ссылка больше не соответствует решению указанной заявки."

msgid "Este link não corresponde mais à pesquisa do chamado informado."
msgstr "Эта ссылка больше не соответствует опросу указанной заявки."

msgid "Ação não autorizada"
msgstr "Действие не разрешено"

msgid "Este link pertence a outro aprovador."
msgstr "Эта ссылка принадлежит другому согласующему."

msgid "Somente o solicitante do chamado pode aceitar ou recusar a solução por e-mail."
msgstr "Только заявитель может принимать или отклонять решение по почте."

msgid "Somente o solicitante do chamado pode responder esta pesquisa por e-mail."
msgstr "Только заявитель может отвечать на этот опрос по почте."

msgid "Validação já processada"
msgstr "Согласование уже обработано"

msgid "Esta validação já foi aprovada ou recusada no GLPI."
msgstr "Это согласование уже утверждено или отклонено в GLPI."

msgid "Solução já processada"
msgstr "Решение уже обработано"

msgid "Esta solução já foi aceita ou recusada no GLPI."
msgstr "Это решение уже принято или отклонено в GLPI."

msgid "Solução não encontrada"
msgstr "Решение не найдено"

msgid "A solução informada neste link não foi encontrada."
msgstr "Решение из этой ссылки не найдено."

msgid "Erro ao processar"
msgstr "Ошибка обработки"

msgid "Não foi possível processar"
msgstr "Не удалось обработать"

msgid "A ação não pôde ser concluída."
msgstr "Действие не удалось завершить."

msgid "Não foi possível concluir a ação."
msgstr "Не удалось завершить действие."

msgid "Se o problema persistir, acesse o GLPI diretamente."
msgstr "Если проблема не уходит — откройте GLPI напрямую."

