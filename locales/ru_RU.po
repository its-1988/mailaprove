msgid "Confirmar ação"
msgstr "Подтвердить действие"

msgid "Confirmar"
msgstr "Подтвердить"

msgid "Confirmação"
msgstr "Подтверждение"

msgid "Ação concluída"
msgstr "Действие выполнено"

